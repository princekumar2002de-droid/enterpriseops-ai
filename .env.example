# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Use letters and digits only in the password (special characters must be URL-encoded
# inside EOPS_DATABASE_URL).

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=eops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=eops
POSTGRES_HOST_PORT=5432

# --- Backend (used when running the API/tests directly on your Mac) ---
EOPS_ENVIRONMENT=local
EOPS_LOG_LEVEL=INFO
EOPS_DATABASE_URL=postgresql+psycopg://eops:change_me_locally@localhost:5432/eops
EOPS_TEST_DATABASE_URL=postgresql+psycopg://eops:change_me_locally@localhost:5432/eops_test
API_HOST_PORT=8000

# --- Added in later weeks (not needed yet) ---
# EOPS_ANTHROPIC_API_KEY=
